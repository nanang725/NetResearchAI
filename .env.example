
# ==============================
# NetResearch AI 环境配置
# ==============================

APP_NAME=NetResearch AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ==============================
# 数据库与文件上传
# ==============================

# 默认使用 backend/data/netresearch.db
# 默认上传目录为 backend/data/uploads
# 默认 Chroma 持久化目录为 backend/data/chroma_db
# 以下配置留空时使用 config.py 中的默认值

CHROMA_DIR=
MAX_UPLOAD_MB=50
MAX_BATCH_FILES=20
MAX_BATCH_UPLOAD_MB=200

# OCR is attempted only for image pages with little or no extractable text.
# PyMuPDF uses the Tesseract executable and language data installed on Windows.
OCR_ENABLED=true
OCR_LANGUAGE=eng+chi_sim
OCR_DPI=200
OCR_MIN_TEXT_CHARS=30

# Semantic duplicate candidate threshold (cosine similarity, 0-1).
SEMANTIC_DUPLICATE_THRESHOLD=0.90

# ==============================
# 跨域配置
# ==============================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================
# Agent Worker 配置
# ==============================

# 同时持有有效 Run 租约的上限（1-16）
AGENT_MAX_CONCURRENT_RUNS=2

# Run 租约有效期（10-300 秒）
AGENT_LEASE_SECONDS=30

# Heartbeat 续租间隔（2-60 秒），必须小于租约有效期
AGENT_HEARTBEAT_SECONDS=10

# Dispatcher 扫描间隔（0.2-10 秒）
AGENT_POLL_SECONDS=1.0

# ==============================
# 大语言模型配置（DeepSeek）
# ==============================

# 填写你自己的 DeepSeek API Key
LLM_API_KEY=

# DeepSeek API 地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL_NAME=deepseek-chat

# 注意：真实 API Key 只放在 .env 中
# 不要提交 .env 到 GitHub
