APP_NAME=NetResearch AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# 以下路径相对于 backend 工作目录。使用 start-backend.bat 时已经切换到 backend。
DATABASE_URL=sqlite:///./data/netresearch.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# Frontend origin for CORS. Vite proxy also forwards /api in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM keys must stay on the backend only. Do not put keys in frontend code.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
