
# ==============================
# NetResearch AI 环境配置
# ==============================

APP_NAME=NetResearch AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ==============================
# 数据库与文件上传
# ==============================

# 默认使用 backend/data/netresearch.db
# 默认上传目录为 backend/data/uploads
# 以下配置留空时使用 config.py 中的默认值

MAX_UPLOAD_MB=50

# ==============================
# 跨域配置
# ==============================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================
# 大语言模型配置（DeepSeek）
# ==============================

# 填写你自己的 DeepSeek API Key
LLM_API_KEY=

# DeepSeek API 地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL_NAME=deepseek-chat

# 注意：真实 API Key 只放在 .env 中
# 不要提交 .env 到 GitHub
